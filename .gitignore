# ── memory / performance debug artifacts (>100 MB, GitHub rejects them) ──
*.hprof
*.trace
captures/

# ── Gradle / build outputs ──
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ── IDE ──
.idea/
*.iml
.externalNativeBuild/
.cxx/

# ── local sensitive / environment config (the README promises not to commit these) ──
local.properties
keystore.properties
*.jks
*.keystore

# ── logs and temporary files ──
*.log
*.tmp

# ── operating system ──
Thumbs.db
.DS_Store
# ── build artifacts: iGEM requires a source repository free of binary deliverables; publish APKs via GitHub Releases / Zenodo ──
*.apk
*.aab

# ── local build scratch (pytest/gradle temp, never committed) ──
.build/
