    <string name="tutorial_home_title">欢迎使用MycoSpec</string>
    <string name="tutorial_home_body">本软件需要与硬件配套，可以测定样品的荧光浓度，并且推断你所检测的样品中是否存在霉变风险。</string>
    <string name="tutorial_project_title">组装硬件</string>
