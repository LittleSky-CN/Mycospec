    <string name="tutorial_home_title">Bienvenido a MycoSpec</string>
    <string name="tutorial_home_body">Esta app funciona con hardware dedicado para medir la concentración de fluorescencia y evaluar el riesgo de moho en sus muestras.</string>
    <string name="tutorial_project_title">Monte el hardware</string>
    <string name="tutorial_project_body">Monte el hardware como se muestra y coloque el teléfono encima.</string>
    <string name="tutorial_step1_title">Calibración de longitud de onda</string>
    <string name="tutorial_step1_body">Inserte el kit de calibración en el puerto de muestra con la sección de calibración de longitud de onda (fuente RGB) frente al teléfono. Luego capture 1–5 imágenes.</string>
    <string name="tutorial_step2_title">Calibración de respuesta espectral</string>
    <string name="tutorial_step2_body">Inserte el kit de calibración en el puerto de muestra con la sección de calibración de fuente (luz blanca) frente al teléfono. Luego capture 1–5 imágenes.</string>
    <string name="tutorial_step3_title">Captura de muestra</string>
    <string name="tutorial_step3_body">Inserte su muestra o blanco en el puerto de muestra y capture 1–5 imágenes.</string>
    <string name="tutorial_step4_title">Curva de calibración</string>
    <string name="tutorial_step4_body">Para construir la curva, inserte cada estándar y su blanco en el puerto de muestra e introduzca la concentración correspondiente.</string>
