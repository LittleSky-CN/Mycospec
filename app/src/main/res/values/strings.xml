    <string name="tutorial_home_title">Welcome to MycoSpec</string>
    <string name="tutorial_home_body">This app works with dedicated hardware to measure fluorescence concentration and assess mold risk in your samples.</string>
    <string name="tutorial_project_title">Assemble the hardware</string>
    <string name="tutorial_project_body">Assemble the hardware as shown and place the phone on top of it.</string>
    <string name="tutorial_step1_title">Wavelength calibration</string>
    <string name="tutorial_step1_body">Insert the calibration kit into the sample port with the wavelength-calibration section (RGB source) facing the phone. Then capture 1–5 images.</string>
    <string name="tutorial_step2_title">Spectral response calibration</string>
    <string name="tutorial_step2_body">Insert the calibration kit into the sample port with the source-calibration section (white light) facing the phone. Then capture 1–5 images.</string>
    <string name="tutorial_step3_title">Sample capture</string>
    <string name="tutorial_step3_body">Insert your sample or blank into the sample port and capture 1–5 images.</string>
    <string name="tutorial_step4_title">Standard curve</string>
    <string name="tutorial_step4_body">To build the standard curve, insert each standard and its blank into the sample port and enter the corresponding concentration.</string>
