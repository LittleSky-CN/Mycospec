    <string name="tutorial_capture_title">Capture Help</string>
    <string name="tutorial_capture_body">Use Capture to shoot 1–5 RAW frames, or import from Gallery / Files (DNG). Keep phone, slit, grating, ISO and focus unchanged between frames. Tap the × on a thumbnail to delete it.</string>
    <string name="tutorial_report_title">Report Help</string>
    <string name="tutorial_report_body">The report collects every computed result: Page 1 wavelength mapping and G validation, Page 2 spectral response and fused curve, Page 3 blank-corrected sample area, Page 4 concentration regression. Values refresh automatically after each batch.</string>
    <string name="tutorial_result_title">Result Help</string>
    <string name="tutorial_result_body">Review the regression formula, R² and predicted concentration. Finish saves the project to History; low R² or negative predictions warn that the curve is unreliable.</string>
    <string name="tutorial_dng_title">DNG Camera Help</string>
    <string name="tutorial_dng_body">Standalone RAW camera: each tap saves a DNG into Pictures/FungalSentinel in your gallery. Use it to collect evidence frames outside a project.</string>
    <string name="tutorial_history_title">History Help</string>
    <string name="tutorial_history_body">Projects: tap an in-progress project to continue where you left off. Preset tabs: view, rename, edit or delete saved calibrations. Export produces a ZIP archive.</string>
    <string name="tutorial_settings_title">Settings Help</string>
    <string name="tutorial_settings_body">Configure language, positioning wavelengths, SPD source, half-screen cover, blank mode and calibration protection. Changes apply to new calculations immediately.</string>
    <string name="tutorial_parameters_title">Parameters Help</string>
    <string name="tutorial_parameters_body">Adjust capture parameters: exposure 10–3000 ms, ISO 50–1600, focus 0–5 D (0 = infinity) and white balance. Keep them fixed during one experiment.</string>
